__id__ = "code_highlight"
__name__ = "Code Highlight"
__description__ = "Inline code in messages (card numbers, commands, codes) gets a soft highlight behind it, like desktop. One tap still copies it. Made by [firestarter1996](https://github.com/firestarter1996)."
__author__ = "firestarter1996"
__version__ = "1.0.0"
__min_version__ = "12.5.1"

# Performance: the inline code spans are swapped once, when a message's text is built
# (MessageObject.addEntitiesToText); nothing runs in Python while drawing or scrolling.
# Stock tap to copy is kept: the new span is still a URLSpanMono. Logcat tag: CodeHighlight.

import base64
import zlib

from java import jclass
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import Header, Selector, Divider

ENTRY = "com.firestarter.codehighlight.CodeCore"
LEVELS = (0x20, 0x30, 0x48)


def _log(msg):
    try:
        jclass("android.util.Log").d("CodeHighlight", str(msg))
    except Exception:
        pass


class CodeHighlightPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            with open(__file__, "r", encoding="utf-8") as fh:
                text = fh.read()
            block = text.rsplit("# __DEX_BEGIN__", 1)[1].split("# __DEX_END__", 1)[0]
            payload = "".join(l.strip()[1:].strip() for l in block.splitlines() if l.strip().startswith("#"))
            data = zlib.decompress(base64.b64decode(payload))
            loader = jclass("dalvik.system.InMemoryDexClassLoader")(jclass("java.nio.ByteBuffer").wrap(data), ctx.getClassLoader())
            core = loader.loadClass(ENTRY)
            self.m = {str(m.getName()): m for m in core.getDeclaredMethods()}
            self._sync()
        except Exception as e:
            _log("load: %s" % e)
            return
        wrap = self.m["wrap"]
        mo = find_class("org.telegram.messenger.MessageObject")
        b = jclass("java.lang.Boolean").TYPE
        i = jclass("java.lang.Integer").TYPE

        class EntitiesHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    wrap.invoke(None, param.args[0])
                except Exception as e:
                    _log("wrap: %s" % e)

        self.hook_method(mo.getDeclaredMethod("addEntitiesToText", find_class("java.lang.CharSequence"),
                                              find_class("java.util.ArrayList"), b, b, b, b, i), EntitiesHook())
        _log("loaded " + __version__)

    def _sync(self, *_):
        try:
            lvl = LEVELS[int(self.get_setting("strength", 1) or 0) % 3]
            self.m["setAlpha"].invoke(None, jclass("java.lang.Integer")(lvl))
        except Exception as e:
            _log("sync: %s" % e)

    def create_settings(self):
        return [
            Header(text="Code Highlight"),
            Selector(key="strength", text="Highlight", default=1, items=["Soft", "Medium", "Strong"], on_change=self._sync),
            Divider(text="Tap inline code to copy it. New messages and reopened chats pick up a change."),
        ]


